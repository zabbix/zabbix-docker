        {
            "name": "aladdin-md5",
            "purl": "pkg:generic/aladdin-md5",
            "licenses": ["Zlib"],
            "file": "src/libs/zbxcrypto/md5.c",
            "version": "2002"
        },
        {
            "name": "drepper-sha-crypt",
            "purl": "pkg:generic/drepper-sha-crypt",
            "licenses": [{"name": "Public Domain"}],
            "file": "src/libs/zbxcrypto/sha512crypt.c",
            "version": "0-unversioned"
        },
        {
            "name": "gnu-getopt",
            "purl": "pkg:generic/gnu-getopt",
            "licenses": ["GPL-2.0-or-later"],
            "file": "src/libs/zbxcommon/zbxgetopt.c",
            "version": "1993"
        },
        {
            "name": "tiny-aes-c",
            "purl": "pkg:github/kokke/tiny-aes-c",
            "licenses": ["Unlicense"],
            "file": "src/libs/zbxcrypto/aes.c",
            "version": "0-unversioned"
        }
    ]
